{
  "Jwt": {
    "Issuer": "MyLifeApi",
    "Audience": "MyLifeFrontend",
    "AccessTokenMinutes": 120,
    "CookieName": "bubu_access_token"
  },
  "Brevo": {
    "Enabled": false,
    "ApiUrl": "https://api.brevo.com/v3/",
    "AssetsBaseUrl": "",
    "SenderEmail": "",
    "SenderName": "Bubu"
  },
  "PasswordReset": {
    "CodeLifetimeMinutes": 10,
    "RequestCooldownSeconds": 60,
    "MaxAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
